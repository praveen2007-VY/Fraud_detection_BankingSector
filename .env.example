# Fraud Detection System Environment Configuration
# Copy this file to .env and configure for your local environment

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraud_detection_2026

# Apache Kafka
KAFKA_BROKER=localhost:9092
KAFKA_INPUT_TOPIC=transactions
KAFKA_PROCESSED_TOPIC=processed_transactions

# Application & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000

# Scoring Thresholds
RISK_SCORE_THRESHOLD=50.0
ANOMALY_SCORE_THRESHOLD=0.5
